                <div class="info">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <?php if ($isActive): ?>
                            <span class="status-pill reserved">Active · <?= time_left($r['expires_at']) ?> left</span>
                        <?php else: ?>
                            <span class="status-pill sold"><?= e(ucfirst($r['status'])) ?></span>
                        <?php endif; ?>
                    </div>
                    <h3 class="text-truncate"><a href="<?= url('product_details.php?id=' . (int) $r['product_id']) ?>" class="text-reset"><?= e($r['title']) ?></a></h3>
                    <div class="small text-muted">
                        <strong class="text-brand"><?= format_price($r['price']) ?></strong>
                        · Seller: <?= e($r['seller_name']) ?> · <i class="bi bi-geo-alt"></i> <?= e($r['location']) ?>
                        · Reserved <?= time_ago($r['created_at']) ?>
                    </div>
                </div>
                <?php if ($isActive): ?>
                    <div class="actions">
                        <a href="<?= url('messages.php?product=' . (int) $r['product_id'] . '&with=' . (int) $r['seller_id']) ?>" class="btn btn-sm btn-outline-brand"><i class="bi bi-chat-dots me-1"></i>Seller</a>
                        <form action="<?= url('reserve.php') ?>" method="post" data-confirm="Cancel this reservation?">
                            <?= csrf_field() ?>
                            <input type="hidden" name="product_id" value="<?= (int) $r['product_id'] ?>">
                            <input type="hidden" name="action" value="cancel">
                            <input type="hidden" name="back" value="reservations">
                            <button class="btn btn-sm btn-soft-danger"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                        </form>
                    </div>
                <?php endif; ?>
