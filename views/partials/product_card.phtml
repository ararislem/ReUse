<?php
/**
 * Carte produit réutilisable.
 * Reçoit : $p      = une ligne de la vue v_products
 *          $favIds = id des produits en favoris
 */
$isFav      = in_array((int) $p['id'], $favIds ?? [], true);
$isSold     = $p['status'] === 'sold';
$isReserved = !$isSold && !empty($p['reserved_until']);
?>
<div class="product-card<?= $isSold ? ' is-sold' : '' ?>">
    <a href="<?= url('product_details.php?id=' . (int) $p['id']) ?>" class="product-media">
        <img src="<?= product_image_url($p['image']) ?>" alt="<?= e($p['title']) ?>" loading="lazy">
        <?php if ($isSold): ?><span class="sold-ribbon">Sold</span><?php endif; ?>
        <?php if ($isReserved): ?><span class="reserved-tag"><i class="bi bi-clock-history"></i> Reserved</span><?php endif; ?>
        <span class="media-cat"><i class="bi <?= e($p['category_icon'] ?? 'bi-tag') ?>"></i> <?= e($p['category_name']) ?></span>
        <?php if (($p['photo_count'] ?? 1) > 1): ?><span class="photo-count"><i class="bi bi-images"></i> <?= (int) $p['photo_count'] ?></span><?php endif; ?>
    </a>

    <?php if (is_logged_in()): ?>
        <form action="<?= url('toggle_favorite.php') ?>" method="post" class="fav-form">
            <?= csrf_field() ?>
            <input type="hidden" name="product_id" value="<?= (int) $p['id'] ?>">
            <button type="submit" class="fav-btn<?= $isFav ? ' active' : '' ?>" aria-label="Save to favorites">
                <i class="bi <?= $isFav ? 'bi-heart-fill' : 'bi-heart' ?>"></i>
            </button>
        </form>
    <?php endif; ?>

    <div class="product-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="product-title"><a href="<?= url('product_details.php?id=' . (int) $p['id']) ?>"><?= e($p['title']) ?></a></h3>
            <?= condition_badge($p['item_condition']) ?>
        </div>
        <div class="product-price"><?= format_price($p['price']) ?></div>
        <div class="product-meta">
            <span><i class="bi bi-geo-alt"></i> <?= e($p['location']) ?></span>
            <span><?= time_ago($p['created_at']) ?></span>
        </div>
        <div class="product-seller">
            <img src="<?= avatar_url($p['seller_picture']) ?>" alt="" class="avatar-xs">
            <span><?= e($p['seller_name']) ?></span>
        </div>
    </div>
</div>
